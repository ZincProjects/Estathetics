# ─── Supabase (required) ───────────────────────────────────────────────
# Project Settings → API. The anon/publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the seed script and webhooks. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Show "Continue with Google" once the Google provider is enabled in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH=false

# ─── App ───────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Set to true to force every external AI/location service into mock mode.
FORCE_MOCK=false

# ─── Anthropic Claude (optional → mock mode when empty) ────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ─── Image redesign (optional → mock mode when empty) ──────────────────
REDESIGN_PROVIDER=replicate
REPLICATE_API_TOKEN=
# owner/model[:version]. Structure-preserving options:
#   adirik/interior-design            (ControlNet seg + MLSD; REPLICATE_INPUT_STYLE=controlnet)
#   black-forest-labs/flux-kontext-pro (instruction image editing; REPLICATE_INPUT_STYLE=edit)
REPLICATE_REDESIGN_MODEL=
# controlnet | edit. Auto-detected from the model name when blank.
REPLICATE_INPUT_STYLE=
REPLICATE_WEBHOOK_SECRET=

# ─── Location (optional) ───────────────────────────────────────────────
# OneMap search is public; credentials unlock themes (hawker centres, clinics…).
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
GOOGLE_PLACES_API_KEY=
